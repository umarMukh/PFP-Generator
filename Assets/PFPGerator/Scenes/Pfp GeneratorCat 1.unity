  DD_Menu: {fileID: 625417189}
  Inputf: {fileID: 1929078198}
  PM_Mode:
    Memes:
    - Line1: To all people who fought covid
      Line2: '#Respect'
    - Line1: The internet new favorite meme
      Line2: if leo can win an oscar, you can
    - Line1: to all our veterans
      Line2: 
    - Line1: Merry christmas
      Line2: Imgflip
    - Line1: Good bye
      Line2: 
    - Line1: When you get to the point
      Line2: you just dont care any more
    - Line1: Check mate bitch
      Line2: 
    - Line1: Me when i drink
      Line2: Sparkling grape juice
    - Line1: 'Happy birth day '
      Line2: Beautiful
    - Line1: I dont always say old sport
      Line2: Oh wait i do
    - Line1: 'Getting a "C" , when your average is an '
      Line2: '"F"'
    - Line1: When you see someone else dealing with BS
      Line2: Your ex tried to put you through
    - Line1: Back row kids
      Line2: Cheers , mate, cheers
    - Line1: Good job ,
      Line2: You are a furry
    - Line1: Toast to elections this year
      Line2: I was bored of our crappy president
    - Line1: The cop after seeing me
      Line2: Kill three furrys
    - Line1: Buy your energy drink now
      Line2: You can be the next president
    - Line1: 'Canada:'
      Line2: Gimme bear
    - Line1: To stop people from being banned for
      Line2: No reason
    - Line1: Start of summer break
      Line2: Party in the comments
    Mode_UI:
    - {fileID: 1947990715}
  Cust_Mode:
    Mode_UI:
    - {fileID: 688579912}
